rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|avif|heic|heif)')
        && request.resource.size <= 15 * 1024 * 1024;
    }

    function isValidVideo() {
      return request.resource.contentType != null
        && request.resource.contentType.matches('video/(mp4|quicktime|webm)')
        && request.resource.size <= 100 * 1024 * 1024;
    }

    function isValidMedia() {
      return isValidImage() || isValidVideo();
    }

    // User-scoped media storage (Wardrobe, Avatar, Reference Photos, Atelier Outputs)
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource != null
        && isValidMedia();
      allow delete: if isOwner(userId);
    }

    // Default Zero-Trust catch-all deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
