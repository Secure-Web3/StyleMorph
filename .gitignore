# ==============================================================================
# StyleMorph Root .gitignore
# Complete Zero-Leakage & Self-Contained Repository Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# JetBrains / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio / Windows
*.suo
*.user
*.useroscl
*.sln.docstates
*.opensdf
*.sdf

# Vim / Emacs
*~
*.swp
*.swo
.#*

# ------------------------------------------------------------------------------
# 2. Strict Security: Secrets, Credentials, Keys & Private Certificates
# ------------------------------------------------------------------------------
# Never commit real environment variable files
*.env
*.env.*
!.env.example

# Firebase & GCP Credentials & Private Keys
*service-account*.json
*service_account*.json
*credentials*.json
google-services.json
GoogleService-Info.plist

# Mobile Signing Keys & Certificates
*.keystore
*.jks
*.p12
*.pem
*.key
*.cert
*.crt
*.der
*.pfx
key.properties
local.properties

# ------------------------------------------------------------------------------
# 3. Dependencies & Node.js Artifacts
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Flutter & Dart Build Artifacts (app/ and admin/)
# ------------------------------------------------------------------------------
**/.dart_tool/
**/.packages
**/.pub-cache/
**/.pub/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Build Outputs
**/build/
**/dist/
app/build/
admin/build/
backend/**/lib/
backend/**/dist/

# Flutter Platform Ephemeral Dirs
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Pods/
**/ios/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Pods/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/android/.gradle/
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# ------------------------------------------------------------------------------
# 5. Firebase & Cloud Emulator Run Logs & State
# ------------------------------------------------------------------------------
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
pubsub-debug.log*
database-debug.log*
*.log

# ------------------------------------------------------------------------------
# 6. Explicit Inclusions (Must ALWAYS be tracked)
# ------------------------------------------------------------------------------
!pubspec.lock
!package-lock.json
!firebase.json
!firestore.rules
!storage.rules
!.firebaserc
!AGENTS.MD
!AGENTS.md
!docs/
!**/*.arb
