rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function protectedUserFields() {
      return [
        'coins',
        'coinBalance',
        'walletBalance',
        'heldBalance',
        'referralCount',
        'networkTier',
        'level',
        'role',
        'permissions',
        'activeDeviceId',
        'activeSessionId'
      ];
    }

    // Enforces Single-Device Session on user subcollections by matching the
    // authenticated token's activeDeviceId claim with users/{userId}.activeDeviceId.
    function hasValidSessionForUser(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return !exists(userPath)
        || !('activeDeviceId' in get(userPath).data)
        || get(userPath).data.activeDeviceId == null
        || (
          'activeDeviceId' in request.auth.token
          && request.auth.token.activeDeviceId == get(userPath).data.activeDeviceId
        );
    }

    function hasValidSessionOnSelf() {
      return !('activeDeviceId' in resource.data)
        || resource.data.activeDeviceId == null
        || (
          'activeDeviceId' in request.auth.token
          && request.auth.token.activeDeviceId == resource.data.activeDeviceId
        );
    }

    // Root user profile document: owner-only with Zero-Trust protection on financial,
    // RBAC, and session-binding fields.
    match /users/{userId} {
      allow read: if isOwner(userId) && hasValidSessionOnSelf();

      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(protectedUserFields());

      allow update: if isOwner(userId)
        && hasValidSessionOnSelf()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());

      allow delete: if false;

      // Virtual Wardrobe items
      match /wardrobe/{itemId} {
        allow read, write: if isOwner(userId) && hasValidSessionForUser(userId);
      }

      // Virtual Atelier & AI Try-On creations
      match /creations/{creationId} {
        allow read, write: if isOwner(userId) && hasValidSessionForUser(userId);
      }

      // Sensitive Wellness & Beauty logs (isolated owner-only + single-device enforced)
      match /wellness_logs/{logId} {
        allow read, write: if isOwner(userId) && hasValidSessionForUser(userId);
      }

      match /wellness/{recordId} {
        allow read, write: if isOwner(userId) && hasValidSessionForUser(userId);
      }

      // Sensitive Wearable & Biometric Health DNA telemetry (Owner-Only read access, server-enforced write)
      match /health_dna/{recordId} {
        allow read: if isOwner(userId) && hasValidSessionForUser(userId);
        allow write: if false;
      }

      // Multi-Device Sessions & Remote Revocation
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // Blocked Devices (for Primary/Master device access control)
      match /blocked_devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // User KYC documents & verification metadata
      match /kyc/{docId} {
        allow read, write: if isOwner(userId) && hasValidSessionForUser(userId);
      }

      // Referral network relationships and rewards
      match /referrals/{referralId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated() && (
          (request.auth.uid == referralId
            && request.resource.data.inviteeUid == request.auth.uid
            && (!('rewardEarned' in request.resource.data) || request.resource.data.rewardEarned == 0)
          )
          || isOwner(userId)
        );
        allow update, delete: if false;
      }
    }

    // Public/authenticated referral code lookup and indexing
    match /referral_codes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Global Immutable Financial Ledger: 100% forbidden for client writes.
    match /ledger/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Active/Historical Coin Holds: server-managed only.
    match /wallet_holds/{holdId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Asynchronous AI Job state: server-managed only.
    match /jobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Shop & Product catalog: authenticated read-only from mobile client.
    match /shops/{sellerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Internal security, idempotency, payment webhook, and audit records.
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /idempotency_keys/{keyId} {
      allow read, write: if false;
    }

    match /payment_events/{eventId} {
      allow read, write: if false;
    }

    match /system_config/{docId} {
      allow read, write: if false;
    }

    // Public App Configuration & Remote Versioning (read-only for all clients)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default Zero-Trust catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
