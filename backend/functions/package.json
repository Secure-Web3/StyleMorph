{
  "name": "stylemorph-functions",
  "version": "1.0.0",
  "description": "StyleMorph Firebase Cloud Functions: Atomic Financial Engine, SSV Payment Webhooks, and Session Guard.",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand src/__tests__/.*\\.unit\\.test\\.ts",
    "test:emulator": "jest --runInBand src/__tests__/financial.test.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "seed": "npm run build && node lib/scripts/seed.js",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "private": true
}
