# ==============================================================================
# StyleMorph Cloud Functions - Safe Environment Blueprint (.env.example)
# Copy this file to .env or .env.local for local execution.
# NEVER commit real production secrets or API keys to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Firebase Local Emulator Configuration
FUNCTIONS_EMULATOR=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Google Cloud Project & Functions Deployment Target
GCLOUD_PROJECT=stylemorph-dev
FUNCTIONS_REGION=europe-west3

# Internal Service Secret (Shared with AI Gateway for SSV & Internal RPC)
# Replace with a high-entropy string in production via Secret Manager
INTERNAL_SERVICE_SECRET=replace_with_local_secret_min_32_chars_12345678

# Payment & AdMob Server-Side Verification (SSV) Webhook Secrets
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret_key
CRYPTO_WEBHOOK_SECRET=replace_with_crypto_signature_secret_key
ADMOB_SSV_KEY=replace_with_admob_ssv_verification_key
