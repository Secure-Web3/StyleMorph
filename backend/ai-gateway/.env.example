# ==============================================================================
# StyleMorph AI Gateway & Multi-Key Load Balancer (.env.example)
# Copy this file to .env or .env.local for local execution on Cloud Run / Node.
# NEVER commit real production secrets or API keys to version control.
# ==============================================================================

# Server Runtime
PORT=8081
NODE_ENV=development

# AI Gateway Execution Mode (true uses fast mock inference without consuming live API tokens)
USE_MOCK_AI=true
MOCK_AI_LATENCY_MS=140

# Cloud Functions Internal RPC Endpoint & Project Config
GCLOUD_PROJECT=stylemorph-dev
FUNCTIONS_REGION=europe-west3
FUNCTIONS_BASE_URL=http://127.0.0.1:5001/stylemorph-dev/europe-west3

# Internal Service Secret (Must match INTERNAL_SERVICE_SECRET in Cloud Functions)
INTERNAL_SERVICE_SECRET=replace_with_local_secret_min_32_chars_12345678

# AI Provider API Keys (Comma-separated Gemini keys for simple pooling)
AI_API_KEYS=gemini_key_pool_placeholder_1,gemini_key_pool_placeholder_2

# Advanced Multi-Project / Multi-Account Key Pool JSON
# Used by keyPool.ts to balance across independent GCP billing projects
AI_KEY_POOL_JSON=[{"key":"mock_key_alpha","provider":"gemini","account":"dev_project_1","tier":"pay-as-you-go","maxRpm":60,"maxTpm":4000000},{"key":"mock_key_beta","provider":"gemini","account":"dev_project_2","tier":"pay-as-you-go","maxRpm":60,"maxTpm":4000000}]

# Quality Guard & Circuit Breaker Thresholds
MIN_ANATOMICAL_SCORE=0.8
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000
